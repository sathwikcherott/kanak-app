{
  "name": "kanak-categorizer",
  "main": "categorizer.mjs",
  "compatibility_date": "2026-11-07",
  "observability": { "enabled": false },
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash-lite" },
  "ratelimits": [
    {
      "name": "CATEGORIZATION_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
